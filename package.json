{
  "name": "safe-code",
  "displayName": "Safe Code",
  "description": "Catch hardcoded secrets before they leave your machine.",
  "version": "0.3.0",
  "publisher": "matheus-tecchio",
  "license": "MIT",
  "icon": "icon.png",
  "files": [
    "out/**",
    "icon.png",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/matheustecchio/safe-code.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:safeCode.scanOpenFiles",
    "onCommand:safeCode.scanWorkspace"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "safeCode.scanOpenFiles",
        "title": "Safe Code: Scan Open Files"
      },
      {
        "command": "safeCode.scanWorkspace",
        "title": "Safe Code: Scan Workspace"
      }
    ],
    "configuration": {
      "title": "Safe Code",
      "properties": {
        "safeCode.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable hardcoded secret diagnostics."
        },
        "safeCode.minimumSecretLength": {
          "type": "number",
          "default": 8,
          "minimum": 8,
          "description": "Minimum value length for generic secret assignment warnings."
        },
        "safeCode.ignoredPaths": {
          "type": "array",
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/dist/**",
            "**/build/**",
            "**/coverage/**",
            "**/vendor/**",
            "**/target/**",
            "**/.cache/**"
          ],
          "items": {
            "type": "string"
          },
          "description": "Workspace-relative glob patterns ignored by Safe Code."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "compile:tests": "tsc -p ./tsconfig.test.json",
    "compile:all": "npm run compile && npm run compile:tests",
    "watch": "tsc -watch -p ./",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "npm run compile:tests && mocha --ui tdd --timeout 5000 \".test-out/test/unit/**/*.test.js\"",
    "test:integration": "npm run compile:all && vscode-test --label integration"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "0.0.12",
    "@vscode/test-electron": "2.5.2",
    "mocha": "^11.8.0",
    "typescript": "^5.5.3"
  }
}
