{
  "name": "safe-code",
  "displayName": "Safe Code",
  "description": "Catch hardcoded secrets before they leave your machine.",
  "version": "0.5.0",
  "publisher": "matheus-tecchio",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/matheustecchio/safe-code.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:safeCode.scanOpenFiles",
    "onCommand:safeCode.scanWorkspace"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "safeCode.scanOpenFiles",
        "title": "Safe Code: Scan Open Files"
      },
      {
        "command": "safeCode.scanWorkspace",
        "title": "Safe Code: Scan Workspace"
      }
    ],
    "menus": {
      "editor/title/context": [
        {
          "command": "safeCode.scanWorkspace",
          "when": "resourceScheme == file",
          "group": "navigation@10"
        }
      ],
      "explorer/context": [
        {
          "command": "safeCode.scanWorkspace",
          "when": "resourceScheme == file",
          "group": "navigation@10"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": "**/.safe-code.json",
        "url": "./schemas/safe-code.schema.json"
      }
    ],
    "configuration": {
      "title": "Safe Code",
      "properties": {
        "safeCode.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable hardcoded secret diagnostics."
        },
        "safeCode.scanWorkspaceOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Automatically scan supported files across the workspace when Safe Code starts."
        },
        "safeCode.minimumSecretLength": {
          "type": "number",
          "default": 8,
          "minimum": 8,
          "description": "Minimum value length for generic secret assignment warnings."
        },
        "safeCode.maxFileSizeBytes": {
          "type": "integer",
          "default": 1048576,
          "minimum": 1,
          "description": "Maximum UTF-8 byte size of an individual file that Safe Code will scan."
        },
        "safeCode.maxWorkspaceScanFiles": {
          "type": "integer",
          "default": 10000,
          "minimum": 1,
          "description": "Maximum number of supported files considered by one full workspace scan."
        },
        "safeCode.maxWorkspaceScanBytes": {
          "type": "integer",
          "default": 104857600,
          "minimum": 1,
          "description": "Maximum total UTF-8 bytes scanned by one full workspace scan."
        },
        "safeCode.ignoredPaths": {
          "type": "array",
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/dist/**",
            "**/build/**",
            "**/coverage/**",
            "**/vendor/**",
            "**/target/**",
            "**/.cache/**"
          ],
          "items": {
            "type": "string"
          },
          "description": "Workspace-relative glob patterns ignored by Safe Code."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "compile:tests": "tsc -p ./tsconfig.test.json",
    "compile:all": "npm run compile && npm run compile:tests",
    "watch": "tsc -watch -p ./",
    "test": "npm run test:release && npm run test:unit && npm run test:integration",
    "test:release": "node --test test/release/*.test.mjs",
    "test:unit": "npm run compile:tests && mocha --ui tdd --timeout 5000 \".test-out/test/unit/**/*.test.js\"",
    "test:integration": "npm run compile:all && vscode-test --label integration",
    "verify:workflow-pins": "node scripts/verify-workflow-pins.mjs",
    "benchmark:workspace-scan": "npm run compile:tests && node --expose-gc test/benchmark/workspaceScanBenchmark.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "0.0.12",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "4.0.0",
    "js-yaml": "4.3.2",
    "mocha": "^11.8.0",
    "typescript": "^5.5.3"
  }
}
